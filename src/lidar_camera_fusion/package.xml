<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
            schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lidar_camera_fusion</name>
  <version>0.1.0</version>
  <description>
    ROS2 Jazzy C++ package: assembles 2D RPLiDAR A1 scans into a 3D PointCloud2
    via TF2 projection (scan_assembler_node), then colorizes the cloud by
    pinhole-projecting it onto a camera image (cloud_colorizer_node).
  </description>
  <maintainer email="damarioforfuture@gmail.com">azzam</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Core ROS2 -->
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_srvs</depend>

  <!-- TF2 stack -->
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_sensor_msgs</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_eigen</depend>

  <!-- 2D → 3D laser projection -->
  <depend>laser_geometry</depend>

  <!-- PCL ↔ ROS2 bridge (pcl_ros not required) -->
  <depend>pcl_conversions</depend>

  <!-- System PCL (no ROS wrapper) -->
  <build_depend>libpcl-all-dev</build_depend>
  <exec_depend>libpcl-common1.14</exec_depend>
  <exec_depend>libpcl-io1.14</exec_depend>

  <!-- Image processing -->
  <depend>cv_bridge</depend>

  <!-- Time-synchronized subscriptions -->
  <depend>message_filters</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
