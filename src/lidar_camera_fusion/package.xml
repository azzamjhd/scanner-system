<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
            schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lidar_camera_fusion</name>
  <version>0.1.0</version>
  <description>
    ROS2 Jazzy C++ package: assembles 2D RPLiDAR A1 scans into a 3D PointCloud2
    via TF2 projection (scan_assembler_node), then colorizes the cloud by
    pinhole-projecting it onto a camera image (cloud_colorizer_node).
  </description>
  <maintainer email="damarioforfuture@gmail.com">azzam</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <!-- Core ROS2 -->
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_srvs</depend>

  <!-- TF2 stack -->
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_sensor_msgs</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_eigen</depend>

  <!-- 2D → 3D laser projection -->
  <depend>laser_geometry</depend>

  <!-- PCL ↔ ROS2 bridge (pcl_ros not required) -->
  <depend>pcl_conversions</depend>

  <!-- Launch/runtime packages used by hardware_only.launch.py.
       micro_ros_agent and rplidar_ros are intentionally not declared here:
       they are often installed/built separately and may not have rosdep keys. -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>v4l2_camera</exec_depend>

  <!-- System PCL (no ROS wrapper). body_preprocess_node also needs the
       segmentation / filters / sample_consensus / search / kdtree libs. -->
  <build_depend>libpcl-all-dev</build_depend>
  <exec_depend>libpcl-common1.14</exec_depend>
  <exec_depend>libpcl-io1.14</exec_depend>
  <exec_depend>libpcl-filters1.14</exec_depend>
  <exec_depend>libpcl-segmentation1.14</exec_depend>
  <exec_depend>libpcl-sample-consensus1.14</exec_depend>
  <exec_depend>libpcl-search1.14</exec_depend>
  <exec_depend>libpcl-kdtree1.14</exec_depend>

  <!-- Image processing -->
  <depend>cv_bridge</depend>
  <exec_depend>image_proc</exec_depend>

  <!-- Time-synchronized subscriptions -->
  <depend>message_filters</depend>

  <!-- scan_image_recorder_node + manual_segmentation_node (Python) -->
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>python3-tk</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>

  <!-- manual_segmentation_node GUI (pyqtgraph + PyQt5) -->
  <exec_depend>python3-pyqtgraph</exec_depend>

  <!-- fusion_gui (Python + Qt) -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>python3-pyqt5</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
