<?xml version="1.0"?>
<robot name="medical_scanner">

  <!-- ============== ROOT LINK ============== -->
  <link name="base_link">
    <inertial>
      <mass value="5.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
    <visual>
      <origin xyz="0.835 0 -0.02" rpy="0 0 0"/>
      <geometry>
        <box size="2.08 1.0 0.04"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.3 0.3 0.1"/>
      </geometry>
    </collision>
  </link>

  <!-- ============== PRISMATIC JOINT (LINEAR GANTRY) ============== -->
  <joint name="gantry_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="gantry_link"/>
    <origin xyz="0 0 0.888" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <!-- Limit motion to ±2 meters along X-axis -->
    <limit lower="-2.0" upper="2.0" effort="100" velocity="1.0"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <!-- ============== GANTRY LINK (MOVING BRACKET) ============== -->
  <link name="gantry_link">
    <inertial>
      <mass value="2.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.15 0.2 0.2"/>
      </geometry>
      <material name="blue">
        <color rgba="0.0 0.0 1.0 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.15 0.2 0.2"/>
      </geometry>
    </collision>
  </link>

  <!-- ============== LIDAR LINK (FIXED TO GANTRY) ============== -->
  <joint name="gantry_to_lidar" type="fixed">
    <parent link="gantry_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.0 0 0" rpy="0 -1.5708 0"/>
  </joint>

  <link name="lidar_link">
    <inertial>
      <mass value="0.3"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.069" length="0.025"/>
      </geometry>
      <material name="red">
        <color rgba="1.0 0.0 0.0 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.06"/>
      </geometry>
    </collision>
  </link>

  <!-- ============== CAMERA LINK (FIXED TO GANTRY) ============== -->
  <joint name="gantry_to_camera" type="fixed">
    <parent link="gantry_link"/>
    <child link="camera_link"/>
    <origin xyz="0.043 0.0 -0.0615" rpy="3.14159 0 1.5708"/>
  </joint>

  <link name="camera_link">
    <inertial>
      <mass value="0.2"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 0.025 0.024"/>
      </geometry>
      <material name="green">
        <color rgba="0.0 1.0 0.0 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.08 0.08"/>
      </geometry>
    </collision>
  </link>

  <!-- ============== CAMERA OPTICAL FRAME (STANDARD OPTICAL ROTATION) ============== -->
  <joint name="camera_to_optical" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <!-- Standard optical frame: -π/2 roll, -π/2 yaw -->
    <origin xyz="0.035 0.04 0.0" rpy="0 0 0"/>
  </joint>

  <link name="camera_optical_frame">
    <inertial>
      <mass value="0.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
  </link>

</robot>
